# LFG — example environment for a local TESTNET run.
# Copy to .env and fill in the <placeholders>:  cp .env.example .env
# Forking LFG for your own collection? AGENTS.md §3.2 lists the variables whose
# mainnet defaults still point at LFG's wallets, CDN and SourceTag.
# Full reference with defaults: lfg_core/config.py (surface-only vars in
# surfaces/<surface>/config.py). The code default network is MAINNET —
# keep XRPL_NETWORK=testnet unless you mean it.

XRPL_NETWORK=testnet

# --- Required by every process (lfg_core/config.py) ---
XUMM_API_KEY=<xaman-developer-api-key>          # https://apps.xumm.dev/
XUMM_API_SECRET=<xaman-developer-api-secret>
SEED=<testnet-wallet-seed>                       # must be a well-formed seed — generate one:
                                                 #   python -c "from xrpl.wallet import Wallet; print(Wallet.create().seed)"
                                                 # fund it from the testnet faucet to actually mint; on testnet it is the issuer
TOKEN_ISSUER_ADDRESS=<testnet-token-issuer-r-address>
TOKEN_CURRENCY_HEX=<40-char-hex-currency-code>
BUNNY_CDN_ACCESS_KEY=<bunnycdn-storage-password>
BUNNY_CDN_STORAGE_ZONE=<bunnycdn-storage-zone>

# --- lfg_service (hub + Discord Activity host) ---
DISCORD_CLIENT_ID=<discord-application-client-id>
DISCORD_CLIENT_SECRET=<discord-application-client-secret>
WEBAPP_SESSION_SECRET=<long-random-string>
WEBAPP_PORT=8176
LAYER_SOURCE=local                               # trait art is not in the repo:
LAYERS_DIR=./layers                              # point this at your own layers/ tree
# WEBAPP_DEV_MODE=1                              # testnet-only UI harness: skips auth; refused on any other network

# --- Classic Discord bot (python main.py) ---
DISCORD_BOT_TOKEN=<discord-bot-token>
ADMIN_LOG_CHANNEL_ID=<discord-channel-id>
LFG_SERVICE_URL=http://localhost:8176
SERVICE_TOKEN_DISCORD=<shared-secret-same-in-bot-and-service>

# --- Telegram bot (python run_telegram.py) ---
# TELEGRAM_BOT_TOKEN=<telegram-bot-token>
# SERVICE_TOKEN_TELEGRAM=<shared-secret-same-in-bot-and-service>
# TELEGRAM_ANNOUNCE_CHAT_ID=<telegram-chat-id>

# --- Optional features (all off unless set; see the README's feature-flags table) ---
# ECONOMY_ENABLED=1
# MARKET_ENABLED=1
# BULK_MINT_UI_ENABLED=1
# CLOSET_MARKET_ENABLED=1
# CLOSET_MARKET_ENC_KEY=<fernet-key>
