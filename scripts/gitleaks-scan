#!/usr/bin/env bash
# Entry of the gitleaks hook in .pre-commit-config.yaml: what the secret scan
# actually reads.
#
# The upstream hook entry is `gitleaks git --pre-commit --staged`, which scans
# the STAGED diff. This repo runs the gate at pre-push and in CI, where nothing
# is staged, so that scanned 0 bytes and passed everything (verified
# 2026-09-22: a committed GitHub token went through). Scan what is leaving the
# box instead:
#
#   pre-push   pre-commit exports PRE_COMMIT_FROM_REF/TO_REF: scan every commit
#              in the pushed range, so a secret added and then deleted inside
#              one push is still caught (it would still be in history).
#   root push  a push carrying a root commit (pre-commit sets no refs, only
#              PRE_COMMIT_REMOTE_NAME/LOCAL_BRANCH): scan the branch's commits
#              that no remote-tracking ref has yet.
#   otherwise  CI's `run --all-files`, manual runs: scan every TRACKED file at
#              HEAD, extracted with git archive. Never the working tree: the
#              main checkout's gitignored .env holds the backend's live seeds.
#
# Rules come from .gitleaks.toml beside this script (the default ruleset plus
# XRPL family seeds). Findings are redacted because CI logs on this public repo
# are public. `gitleaks` itself is the binary pre-commit built for the pinned
# rev; it is on PATH inside the hook's environment.
set -euo pipefail

config="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/.gitleaks.toml"
root="$(git rev-parse --show-toplevel)"
flags=(--config "$config" --redact --no-banner --verbose)

if [[ -n "${PRE_COMMIT_FROM_REF:-}" && -n "${PRE_COMMIT_TO_REF:-}" ]]; then
    exec gitleaks git "${flags[@]}" \
        --log-opts="${PRE_COMMIT_FROM_REF}..${PRE_COMMIT_TO_REF}" \
        "$root"
fi

# A push that carries a root commit gets no FROM/TO refs, only the remote and
# local branch: scan that branch's commits no remote-tracking ref has yet.
if [[ -n "${PRE_COMMIT_REMOTE_NAME:-}" && -n "${PRE_COMMIT_LOCAL_BRANCH:-}" ]]; then
    exec gitleaks git "${flags[@]}" \
        --log-opts="${PRE_COMMIT_LOCAL_BRANCH} --not --remotes=${PRE_COMMIT_REMOTE_NAME}" \
        "$root"
fi

tree="$(mktemp -d)"
trap 'rm -rf "$tree"' EXIT
git -C "$root" archive --format=tar HEAD | tar -x -C "$tree"
# Scan from inside the extract so findings name repo-relative paths.
cd "$tree"
gitleaks dir "${flags[@]}" .
